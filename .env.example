DATABASE_URL=sqlite:///./pokedex.db
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
CORS_ORIGINS=["http://localhost:5173"]
# Opcional: segundos de espera a la PokeAPI antes de responder 504 (por defecto 5)
# POKEAPI_TIMEOUT=5
# Opcional: nivel de log (DEBUG, INFO, WARNING o ERROR). Por defecto INFO
# LOG_LEVEL=INFO
# Opcional: archivo de log además de la consola (por defecto pokedex_api.log; vacío = solo consola)
# LOG_FILE=pokedex_api.log
